---
import "../styles/blueprint-theme.css";

interface Props {
  title: string;
  // Used for <meta name="description">, Open Graph, and Twitter Card tags.
  // Keep it to one plain-language sentence about the page.
  description: string;
  // Filename only, e.g. "taipan-hero.jpg" — resolved against
  // BASE_URL + "images/". Falls back to a sitewide default image below.
  image?: string;
  // "blueprint" (default) is the drafting-sheet look used everywhere.
  // "gallery" swaps in a darker, minimalist palette for the
  // astrophotography page — see .theme-gallery in blueprint-theme.css.
  variant?: "blueprint" | "gallery";
}

const { title, description, image, variant = "blueprint" } = Astro.props;
const currentPath = Astro.url.pathname;

const DEFAULT_OG_IMAGE = "veil-nebula.jpg";
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(
  `${import.meta.env.BASE_URL}images/${image ?? DEFAULT_OG_IMAGE}`,
  Astro.site
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="theme-color" content="#c4202e" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class={variant === "gallery" ? "theme-gallery" : undefined}>
    <div class="sheet sheet-frame">
      <nav class="site-nav">
        <a class="brand" href={import.meta.env.BASE_URL}>Henry Nickless</a>
        <ul>
          <li>
  <a 
    class="nav-btn"
    href={import.meta.env.BASE_URL} 
    aria-current={currentPath === import.meta.env.BASE_URL ? "page" : undefined}
  >
    Home
  </a>
</li>
<li>
  <a 
    class="nav-btn"
    href={`${import.meta.env.BASE_URL}projects`} 
    aria-current={currentPath.includes("/projects") ? "page" : undefined}
  >
    Projects
  </a>
</li>
<li>
  <a 
    class="nav-btn"
    href={`${import.meta.env.BASE_URL}about`} 
    aria-current={currentPath.includes("/about") ? "page" : undefined}
  >
    About
  </a>
</li>
<li>
  <a 
    class="nav-btn"
    href={`${import.meta.env.BASE_URL}astrophotography`} 
    aria-current={currentPath.includes("/astrophotography") ? "page" : undefined}
  >
    Astrophotography
  </a>
</li>
<li>
  <a
    class="nav-btn nav-icon-btn"
    href="https://instagram.com/astro.htn"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram: @astro.htn"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.3" cy="6.7" r="0.65" fill="currentColor" stroke="none" />
    </svg>
  </a>
</li>
        </ul>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Henry Nickless, Aerospace Engineering, CU Boulder</span>
        <span>
          <a href="mailto:Henry.Nickless@Colorado.edu">Henry.Nickless@Colorado.edu</a>
          &nbsp;/&nbsp;
          <a href="https://linkedin.com/in/henrynickless/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          &nbsp;/&nbsp;
          <a href="https://github.com/Htnick" target="_blank" rel="noopener noreferrer">GitHub</a>
          &nbsp;/&nbsp;
          <a href={`${import.meta.env.BASE_URL}files/resume/Henry_Nickless_Resume.pdf`} target="_blank" rel="noopener noreferrer">Resume</a>
        </span>
      </footer>
    </div>
  </body>
</html>
