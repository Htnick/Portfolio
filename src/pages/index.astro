---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);

// Hand-picked showcase, in this order: the regeneratively cooled engine
// (the headline project), the injector plate that feeds it, and the
// Rokinon astro rig.
const FEATURED_SLUGS = [
  "regeneratively-cooled-engine",
  "injector-plate-topology-optimization",
  "rokinon-135mm-astro-rig",
];
const featured = FEATURED_SLUGS
  .map((slug) => allProjects.find((p) => p.id === slug))
  .filter((p) => p !== undefined);

// The two halves of the hero. Every figure below is taken from the
// project pages themselves — don't add one here that isn't sourced
// there, and don't imply hardware has been fired or flown when it
// hasn't. The regen engine is a design effort; Taipan has not been
// hot fired.
const DISCIPLINES = [
  {
    label: "Propulsion",
    href: "projects",
    // A 4:3 crop of the standing-engine render, not regen-engine-hero.jpg —
    // that one is the regen project's own card image and appears directly
    // below, so using it here would show the same render twice.
    image: "regen-engine-tile.jpg",
    alt: "CAD render of the regeneratively cooled engine: injector and manifold on top, chamber body, and the nozzle below",
    body:
      "Combustion chamber sizing, injector plate design, and cooling analysis " +
      "at CU Sounding Rocket Lab — a 2,000 lbf regeneratively cooled engine " +
      "and a 650 lbf bipropellant engine.",
    meta: "CU SRL · Liquids Team",
  },
  {
    label: "Astrophotography",
    href: "astrophotography",
    image: "veil-nebula.jpg",
    alt: "The Veil Nebula, astrophotography by Henry Nickless",
    body:
      "Forty deep-sky images shot on a rig I designed and printed myself — " +
      "three-ring lens mounts and a belt-driven focuser around a 135mm f/2.",
    meta: "Rokinon 135mm rig",
  },
];

const RESUME = "files/resume/Henry_Nickless_Resume.pdf";
---

<Layout
  title="Henry Nickless"
  description="Henry Nickless is an aerospace engineering student at CU Boulder designing liquid rocket injector plates and regeneratively cooled engines, and building 3D-printed telescope hardware for deep-sky astrophotography."
>
  <section class="hero">
    <span class="eyebrow">// Aerospace Engineering, CU Boulder</span>
    <h1>Henry Nickless</h1>
    <p class="hero-tagline">I take pictures of the night&nbsp;sky and build rocket engines.</p>
    <p class="lede">
      On the propulsion team at CU's Sounding Rocket Lab I size combustion
      chambers and design injector plates — currently for a 2,000 lbf
      regeneratively cooled engine. Off campus I print my own telescope
      hardware and photograph the deep sky with it.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}projects`}>View Projects</a>
      <a class="btn" href={`${import.meta.env.BASE_URL}${RESUME}`} target="_blank" rel="noopener noreferrer">Résumé (PDF)</a>
      <a class="btn" href="mailto:Henry.Nickless@Colorado.edu">Email Me</a>
    </div>

    <div class="title-block">
      <div><span class="label">Program</span><span class="value">Aerospace Eng.</span></div>
      <div><span class="label">Institution</span><span class="value">CU Boulder</span></div>
      <div><span class="label">Grad</span><span class="value">May 2028</span></div>
    </div>
  </section>

  <div class="cut-line"><span>Two Disciplines</span></div>

  <div class="discipline-split">
    {DISCIPLINES.map((d) => (
      <a class="discipline" href={`${import.meta.env.BASE_URL}${d.href}`}>
        <div class="discipline-frame">
          <img src={`${import.meta.env.BASE_URL}images/${d.image}`} alt={d.alt} loading="eager" />
        </div>
        <span class="discipline-meta">{d.meta}</span>
        <h2>{d.label}</h2>
        <p>{d.body}</p>
      </a>
    ))}
  </div>

  <div class="cut-line"><span>Selected Work</span></div>

  <p class="section-intro">
    What I'm building right now at SRL, plus one favorite from last year.
  </p>

  <div class="project-grid">
    {featured.map((project, i) => (
      <a class="project-card" href={`${import.meta.env.BASE_URL}projects/${project.id}`}>
        <div class="thumb-frame">
          {project.data.image ? (
            <img src={`${import.meta.env.BASE_URL}images/${project.data.image}`} alt={project.data.title} loading="lazy" />
          ) : (
            <ImagePlaceholder label={`Photo: ${project.data.title}`} spec="1600×1000" figNo={String(i + 1).padStart(2, "0")} />
          )}
        </div>
        <span class="sheet-no" style={project.data.status === "in-progress" ? "color: var(--redline-text);" : ""}>
          SHT {String(i + 1).padStart(2, "0")} / {project.data.status === "completed" ? "COMPLETE" : "IN PROGRESS"}
        </span>
        <h3>{project.data.title}</h3>
        <p>{project.data.description}</p>
        {project.data.results && <p class="card-result">{project.data.results}</p>}
        <div class="tags">
          {project.data.tags?.slice(0, 3).map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <p class="all-projects">
    <a href={`${import.meta.env.BASE_URL}projects`}>View all projects</a>
  </p>

  <div class="section-panel">
    <div class="cut-line"><span>By The Numbers</span></div>

    <div class="stat-band">
      <div class="stat">
        <span class="stat-number">2,000</span>
        <span class="stat-label">lbf regen engine — in design</span>
      </div>
      <div class="stat">
        <span class="stat-number">650</span>
        <span class="stat-label">lbf Taipan bipropellant</span>
      </div>
      <div class="stat">
        <span class="stat-number">700</span>
        <span class="stat-label">psi chamber, RP-1 / LOX</span>
      </div>
      <div class="stat">
        <span class="stat-number">40</span>
        <span class="stat-label">deep-sky images</span>
      </div>
    </div>

    <p class="toolset-line">
      Fusion 360 · SolidWorks · Python · MATLAB · C++ · R · NASA CEA / RocketCEA · 3D printing &amp; CNC
    </p>
  </div>

  <div class="section-panel section-panel--cool">
    <div class="cut-line"><span>Get In Touch</span></div>

    <section class="hero" style="padding-top: 0;">
      <span class="eyebrow">// Say hello</span>
      <h2>Always happy to talk propulsion, optics, or anything in between.</h2>
      <div class="hero-actions">
        <a class="btn btn-primary" href="mailto:Henry.Nickless@Colorado.edu">Email Me</a>
        <a class="btn" href="https://linkedin.com/in/henrynickless/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn" href={`${import.meta.env.BASE_URL}${RESUME}`} target="_blank" rel="noopener noreferrer">Résumé (PDF)</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Name first, then the one-line version of what he does. The tagline
     carries the claim the h1 used to, so it is sized to be read as a
     headline rather than as body copy. */
  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.7vw, 1.8rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--paper);
    max-width: 30ch;
    margin: -0.2rem 0 1.1rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  /* Two co-equal halves: propulsion and astrophotography. The pairing is
     the thing that distinguishes this site, so neither side is subordinate
     and both images are given the same footprint. */
  .discipline-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
  }

  .discipline {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }

  .discipline-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line-500);
    background: var(--ink-800);
  }

  .discipline-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .discipline:hover .discipline-frame img {
    transform: scale(1.03);
  }

  .discipline-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--paper-dim);
  }

  .discipline h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }

  .discipline:hover h2 {
    color: var(--redline);
  }

  .discipline p {
    margin: 0;
    color: var(--paper-dim);
    font-size: 0.95rem;
    max-width: 46ch;
  }

  .section-intro {
    color: var(--paper-dim);
    margin-top: -0.5rem;
    margin-bottom: 1.75rem;
    max-width: 46ch;
  }

  /* The quantified outcome from a project's frontmatter, when it has one.
     Set apart from the description so it reads as evidence rather than
     more prose. */
  .card-result {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--paper);
    border-left: 2px solid var(--redline);
    padding-left: 0.7rem;
    margin: 0;
  }

  .all-projects {
    text-align: right;
    margin-top: 1.5rem;
  }
  .all-projects a {
    font-family: var(--font-mono);
    text-decoration: none;
    color: var(--paper-dim);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .all-projects a:hover {
    color: var(--redline-text);
  }

  /* Tool names kept for scanning, but demoted out of the chip grid they
     used to sit in — a wall of generic tool chips says less than any one
     project page does. */
  .toolset-line {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.9;
    color: var(--paper-dim);
    margin: 1.5rem 0 0;
    max-width: 70ch;
  }
</style>
