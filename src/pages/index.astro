---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import BlueprintGraphic from "../components/BlueprintGraphic.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);

// Feature the 3 most recent projects, completed work first
const featured = allProjects
  .sort((a, b) => {
    if (a.data.status !== b.data.status) {
      return a.data.status === "completed" ? -1 : 1;
    }
    return b.data.date.localeCompare(a.data.date);
  })
  .slice(0, 3);
---

<Layout title="Henry Nickless">
  <section class="hero">
    <div class="hero-layout">
      <div>
        <span class="eyebrow">// Aerospace Engineering, CU Boulder</span>
        <h1>Henry Nickless</h1>
        <p class="lede">
          I design and build liquid rocket engines and precision instruments —
          currently working on injector plates and regenerative cooling at CU's
          Sounding Rocket Lab, and 3D-printed telescope hardware on the side.
        </p>
        <div style="display: flex; gap: 1rem; margin-top: 1.75rem; flex-wrap: wrap;">
          <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}projects`}>View Projects</a>
          <a class="btn" href={`${import.meta.env.BASE_URL}about`}>About Me</a>
        </div>

        <div class="title-block">
          <div><span class="label">Program</span><span class="value">Aerospace Eng.</span></div>
          <div><span class="label">Institution</span><span class="value">CU Boulder</span></div>
          <div><span class="label">Grad</span><span class="value">May 2028</span></div>
          <div><span class="label">Focus</span><span class="value">Propulsion</span></div>
        </div>
      </div>

      <BlueprintGraphic />
    </div>
  </section>

  <div class="stat-band">
    <div class="stat">
      <span class="stat-number">650</span>
      <span class="stat-label">LBF — Taipan Thrust</span>
    </div>
    <div class="stat">
      <span class="stat-number">2,000</span>
      <span class="stat-label">LBF — Regen Target</span>
    </div>
    <div class="stat">
      <span class="stat-number">700</span>
      <span class="stat-label">PSI Chamber Pressure</span>
    </div>
    <div class="stat">
      <span class="stat-number">2028</span>
      <span class="stat-label">Graduation</span>
    </div>
  </div>

  <div class="cut-line"><span>Selected Work</span></div>

  <div class="project-grid">
    {featured.map((project, i) => (
      <a class="project-card" href={`${import.meta.env.BASE_URL}projects/${project.id}`}>
        <div class="thumb-frame">
          {project.data.image ? (
            <img src={`${import.meta.env.BASE_URL}images/${project.data.image}`} alt={project.data.title} loading="lazy" />
          ) : (
            <ImagePlaceholder label={`Photo — ${project.data.title}`} spec="1600×1000" figNo={String(i + 1).padStart(2, "0")} />
          )}
        </div>
        <span class="sheet-no" style={project.data.status === "in-progress" ? "color: var(--redline);" : ""}>
          SHT {String(i + 1).padStart(2, "0")} / {project.data.status === "completed" ? "COMPLETE" : "IN PROGRESS"}
        </span>
        <h3>{project.data.title}</h3>
        <p>{project.data.description}</p>
        <div class="tags">
          {project.data.tags?.slice(0, 3).map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <p style="text-align: right; margin-top: 1.5rem;">
    <a class="mono" href={`${import.meta.env.BASE_URL}projects`} style="text-decoration: none; color: var(--paper-dim); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase;">
      View all projects →
    </a>
  </p>

  <div class="cut-line"><span>Toolset</span></div>

  <div class="skills-strip">
    {["Fusion 360", "SolidWorks", "Python", "MATLAB", "C++", "R", "3D Printing / CNC", "NASA CEA / RocketCEA"].map((skill) => (
      <span class="skill-chip">{skill}</span>
    ))}
  </div>

  <div class="cut-line"><span>Get In Touch</span></div>

  <section class="hero" style="padding-top: 0;">
    <span class="eyebrow">// Say hello</span>
    <h2>Always happy to talk propulsion, optics, or anything in between.</h2>
    <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
      <a class="btn btn-primary" href="mailto:Henry.Nickless@Colorado.edu">Email Me</a>
      <a class="btn" href="https://linkedin.com/in/henrynickless/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>
</Layout>

<style>
  .skills-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--paper);
    border: 1px solid var(--line-500);
    background: var(--ink-800);
    padding: 0.45rem 0.9rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .skill-chip:hover {
    border-color: var(--redline);
    color: var(--redline);
  }
</style>
