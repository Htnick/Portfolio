---
import Layout from '../../layouts/Layout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import AstroImage from '../../components/AstroImage.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/project-extras.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// This is the one project page long enough (4,000+ words, one giant
// embedded trade-study script) that a reader benefits from jumping
// straight to a section instead of scrolling linearly.
const showToc = ["regeneratively-cooled-engine", "regen-engine-tvc", "injector-plate-topology-optimization"].includes(entry.id);
const tocHeadings = headings.filter((h) => h.depth === 2);

// Each project can set its own --redline accent, but the raw accent is
// rarely dark enough for small text (FIG. captions, eyebrows) against
// the light theme's backgrounds — worst case is --panel-tint at ~0.81
// relative luminance, needing text at ~4.5:1 (WCAG AA). Darken toward
// black in RGB space, preserving hue, until that ratio is met.
function hexToRgb(hex: string) {
  const clean = hex.replace('#', '');
  return [0, 2, 4].map((i) => parseInt(clean.slice(i, i + 2), 16));
}
function rgbToHex([r, g, b]: number[]) {
  const toHex = (c: number) => Math.round(Math.min(255, Math.max(0, c))).toString(16).padStart(2, '0');
  return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
}
function relLuminance([r, g, b]: number[]) {
  const lin = (c: number) => {
    c /= 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  };
  return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
}
const PANEL_TINT_LUMINANCE = 0.8124;
function darkenForContrast(hex: string, targetRatio = 4.5) {
  let [r, g, b] = hexToRgb(hex);
  for (let i = 0; i < 60; i++) {
    const ratio = (PANEL_TINT_LUMINANCE + 0.05) / (relLuminance([r, g, b]) + 0.05);
    if (ratio >= targetRatio) break;
    r *= 0.95; g *= 0.95; b *= 0.95;
  }
  return rgbToHex([r, g, b]);
}

const accentVars = entry.data.accent
  ? `--redline: ${entry.data.accent}; --redline-text: ${darkenForContrast(entry.data.accent)};`
  : undefined;
---

<Layout
  title={`${entry.data.title} | Henry Nickless`}
  description={entry.data.description}
  image={entry.data.image}
>
  <a href={`${import.meta.env.BASE_URL}projects`} class="mono" style="display: inline-block; margin-bottom: 1.5rem; text-decoration: none; color: var(--paper-dim);">← Back to projects</a>

  <article style={accentVars}>
    <div class="project-accent-bar"></div>
    <span class="eyebrow" style="font-family: var(--font-mono); color: var(--redline-text); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 0.75rem;">
      {entry.data.status === "completed" ? "// Completed" : "// In Progress"}
    </span>
    <h1>{entry.data.title}</h1>
    <p class="lede" style="margin-bottom: 2rem;">{entry.data.description}</p>

    <div class="title-block" style="margin-bottom: 2.5rem;">
      <div><span class="label">Date</span><span class="value">{entry.data.date}</span></div>
      <div><span class="label">Status</span><span class="value">{entry.data.status}</span></div>
      {entry.data.role && <div><span class="label">Role</span><span class="value">{entry.data.role}</span></div>}
      <div><span class="label">Tags</span><span class="value">{entry.data.tags?.join(", ")}</span></div>
    </div>

    {entry.data.results && (
      <p class="results-callout">
        <span class="results-label">Results</span>
        {entry.data.results}
      </p>
    )}

    {showToc && tocHeadings.length > 0 && (
      <nav class="project-toc" aria-label="Section navigation">
        <span class="project-toc-label mono">On this page</span>
        <ol>
          {tocHeadings.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    {entry.data.image ? (
      <div class="project-hero-photo">
        <AstroImage src={`${import.meta.env.BASE_URL}images/${entry.data.image}`} alt={entry.data.title} figNo="01" caption={entry.data.title.toUpperCase()} />
      </div>
    ) : (
      <div style="margin-bottom: 2rem;">
        <ImagePlaceholder label={`Hero photo: ${entry.data.title}`} aspect="wide" spec="1800×900, landscape" figNo="01" />
      </div>
    )}

    <div class="project-content">
      <Content />
    </div>
  </article>
</Layout>

<script>
  // Turns every fenced code block on a project page into a code panel:
  // file name + line count bar, copy button, a section outline built from
  // the script's own "# ==== NAME ====" banner comments, line numbers, and
  // a collapsed preview so a 500-line script doesn't swallow the page.
  // An optional <div class="code-meta" data-file="..." data-desc="...">
  // placed right before the fence supplies the file name and a summary.
  function buildPanels() {
    const blocks = document.querySelectorAll<HTMLPreElement>('.project-content pre.astro-code');
    blocks.forEach((pre, idx) => {
      if (pre.closest('.code-panel')) return;
      const meta = pre.previousElementSibling as HTMLElement | null;
      const hasMeta = meta?.classList.contains('code-meta');
      const lang = pre.dataset.language || 'code';
      const file = (hasMeta && meta!.dataset.file) || `${lang} snippet`;
      const desc = hasMeta ? meta!.dataset.desc : undefined;
      const lines = Array.from(pre.querySelectorAll<HTMLElement>('.line'));
      const total = lines.length;

      const panel = document.createElement('div');
      panel.className = 'code-panel';
      const long = total > 30;
      if (long) panel.classList.add('is-collapsed');

      const bar = document.createElement('div');
      bar.className = 'code-panel__bar';
      bar.innerHTML = `<span class="code-panel__file"></span><span class="code-panel__meta"></span>`;
      (bar.querySelector('.code-panel__file') as HTMLElement).textContent = file;
      (bar.querySelector('.code-panel__meta') as HTMLElement).textContent = `${lang} · ${total} lines`;
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'code-panel__btn';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(lines.map((l) => l.textContent ?? '').join('\n'));
          copy.textContent = 'Copied';
        } catch {
          copy.textContent = 'Select & copy';
        }
        setTimeout(() => (copy.textContent = 'Copy'), 1600);
      });
      bar.appendChild(copy);

      let toggle: HTMLButtonElement | null = null;
      if (long) {
        toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'code-panel__btn';
        toggle.textContent = 'Expand';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.addEventListener('click', () => setOpen(!panel.classList.contains('is-collapsed') ? false : true));
        bar.appendChild(toggle);
      }

      const body = document.createElement('div');
      body.className = 'code-panel__body';
      pre.parentNode!.insertBefore(panel, pre);
      panel.appendChild(bar);
      if (desc) {
        const d = document.createElement('p');
        d.className = 'code-panel__desc';
        d.textContent = desc;
        panel.appendChild(d);
      }

      // Outline from banner comments like "# ===== NOZZLE CONFIGURATIONS =====".
      const sections: { name: string; line: HTMLElement }[] = [];
      lines.forEach((l) => {
        const m = (l.textContent ?? '').match(/^\s*(?:#|\/\/|%)\s*=+\s*(.+?)\s*=+\s*$/);
        if (m) sections.push({ name: m[1].toLowerCase().replace(/(^|\s)\S/g, (c) => c.toUpperCase()), line: l });
      });
      if (sections.length >= 2) {
        const nav = document.createElement('div');
        nav.className = 'code-panel__outline';
        nav.innerHTML = '<span>Jump to</span>';
        sections.forEach((sec) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = sec.name;
          b.addEventListener('click', () => {
            setOpen(true);
            lines.forEach((l) => l.classList.remove('is-target'));
            sec.line.classList.add('is-target');
            sec.line.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
          nav.appendChild(b);
        });
        panel.appendChild(nav);
      }

      panel.appendChild(body);
      body.appendChild(pre);
      if (hasMeta) meta!.remove();

      let foot: HTMLDivElement | null = null;
      if (long) {
        foot = document.createElement('div');
        foot.className = 'code-panel__foot';
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'code-panel__btn';
        more.textContent = `Show all ${total} lines`;
        more.addEventListener('click', () => setOpen(true));
        foot.appendChild(more);
        panel.appendChild(foot);
      }

      function setOpen(open: boolean) {
        if (!long) return;
        panel.classList.toggle('is-collapsed', !open);
        if (toggle) {
          toggle.textContent = open ? 'Collapse' : 'Expand';
          toggle.setAttribute('aria-expanded', String(open));
        }
        if (foot) foot.hidden = open;
        if (!open) panel.scrollIntoView({ block: 'nearest' });
      }
    });
  }
  buildPanels();
</script>

<style>
  /* Hero photo (FIG. 01) on a project detail page — kept smaller than
     full content width. Images further down in the Overview/body content
     (FIG. 02+) are untouched and keep their own full-width sizing. */
  .project-hero-photo {
    max-width: 420px;
    margin: 0 0 2rem;
  }

  @media (max-width: 640px) {
    .project-hero-photo {
      max-width: 100%;
    }
  }

  .project-accent-bar {
    width: 3rem;
    height: 4px;
    background: var(--redline);
    margin-bottom: 1.1rem;
  }

  .results-callout {
    border-left: 3px solid var(--redline);
    background: var(--panel-tint);
    padding: 0.9rem 1.25rem;
    margin: 0 0 2rem;
    font-size: 0.98rem;
    color: var(--paper);
    max-width: 62ch;
  }
  .results-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--redline-text);
    margin-bottom: 0.35rem;
  }

  .project-toc {
    border: 1px solid var(--line-500);
    background: var(--ink-800);
    padding: 1rem 1.25rem;
    margin: 0 0 2rem;
    max-width: 360px;
  }
  .project-toc-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin-bottom: 0.6rem;
  }
  .project-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .project-toc li {
    counter-increment: toc;
    font-size: 0.88rem;
  }
  .project-toc li::before {
    content: counter(toc) ". ";
    color: var(--redline-text);
    font-family: var(--font-mono);
  }
  .project-toc a {
    color: var(--paper);
    text-decoration-color: var(--line-500);
  }
  .project-toc a:hover {
    color: var(--redline-text);
  }

  .project-content :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--redline);
  }

  .project-content :global(h3) {
    margin-top: 1.75rem;
    color: var(--paper-dim);
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.25rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--paper);
  }

  .project-content :global(strong) {
    color: var(--paper);
  }
</style>
