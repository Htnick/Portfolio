---
import Layout from "../../layouts/Layout.astro";
import "../../styles/project-cards.css";
import { getCollection } from "astro:content";

const BASE = import.meta.env.BASE_URL;
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const byDate = (a: any, b: any) => b.data.date.localeCompare(a.data.date);

const groups = [
  { id: "in-progress", label: "In Progress", items: allProjects.filter((p) => p.data.status === "in-progress").sort(byDate) },
  { id: "completed", label: "Completed", items: allProjects.filter((p) => p.data.status === "completed").sort(byDate) },
];

const year = (d: string) => d.slice(0, 4);
---

<Layout
  title="Projects | Henry Nickless"
  description="Rocket engines, telescopes, and the occasional glider: a running log of what Henry Nickless has been building."
  variant="gallery"
>
  <header class="proj-head">
    <div>
      <span class="eyebrow mono">// Index</span>
      <h1>Projects</h1>
      <p class="lede">
        Rocket engines, telescopes, and the occasional glider: a running log
        of what I've been building.
      </p>
    </div>
    <nav class="proj-jump mono" aria-label="Project groups">
      {groups.map((g) => (
        <a href={`#${g.id}`}>{g.label} <span>{g.items.length}</span></a>
      ))}
    </nav>
  </header>

  {groups.map((g) => (
    <section class="proj-group" id={g.id}>
      <h2 class="proj-group-title mono">{g.label}<span>{g.items.length}</span></h2>
      <div class="proj-grid">
        {g.items.map((project) => (
          <a class="proj-card" href={`${BASE}projects/${project.id}/`}>
            <div class="proj-thumb">
              {project.data.image ? (
                <img src={`${BASE}images/${project.data.image}`} alt="" loading="lazy" />
              ) : (
                <span class="proj-thumb-empty mono">{project.data.tags?.[0] ?? "project"}</span>
              )}
            </div>
            <div class="proj-body">
              <span class:list={["proj-meta mono", { live: g.id === "in-progress" }]}>
                {g.id === "in-progress" ? "In progress" : "Complete"} · {year(project.data.date)}
              </span>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="proj-tags">
                {project.data.tags?.slice(0, 3).map((tag: string) => (
                  <span class="mono">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>

<style>
  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 0.5rem 0 1.75rem;
    border-bottom: 1px solid var(--line-500);
    margin-bottom: 2rem;
  }
  .proj-head .eyebrow {
    display: block;
    color: var(--redline);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .proj-head h1 { margin: 0 0 0.6rem; font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .proj-head .lede { margin: 0; max-width: 58ch; color: var(--paper-dim); }
  .proj-jump { display: flex; gap: 0.5rem; font-size: 0.74rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .proj-jump a {
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line-500);
    color: var(--paper-dim);
    text-decoration: none;
  }
  .proj-jump a:hover { border-color: var(--redline); color: var(--paper); }
  .proj-jump span { color: var(--redline); margin-left: 0.35rem; }

  .proj-group { margin: 0 0 3rem; scroll-margin-top: 1.5rem; }
  .proj-group-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0 0 1rem;
  }
  .proj-group-title span { color: var(--paper-dim); }

</style>
