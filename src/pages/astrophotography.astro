---
import Layout from "../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";
import { GALLERY_META } from "../data/astro-gallery-meta";

// Auto-discovered gallery: every JPG/PNG dropped into
// public/images/astrophotography/ shows up here on the next build — no
// code changes needed to add a new photo. See PHOTOS_NEEDED.md. Per-image
// target/date/integration-time overrides live in src/data/astro-gallery-meta.ts.
const galleryDir = path.join(process.cwd(), "public/images/astrophotography");
const galleryFiles = fs.existsSync(galleryDir)
  ? fs
      .readdirSync(galleryDir)
      .filter((f) => /\.(jpe?g|png)$/i.test(f))
      .sort((a, b) => a.localeCompare(b))
  : [];

function labelFor(filename: string) {
  const base = filename.replace(/\.[^.]+$/, "");
  return base
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function formatMonthYear(iso?: string) {
  const m = iso?.match(/^(\d{4})-(\d{2})/);
  return m ? `${MONTHS[Number(m[2]) - 1]} ${m[1]}` : undefined;
}

const galleryItems = galleryFiles.map((file) => {
  const meta = GALLERY_META[file] ?? {};
  const label = meta.target ?? labelFor(file);
  const dateLabel = formatMonthYear(meta.date);
  const captionParts = [dateLabel, meta.integrationTime, meta.equipment].filter(Boolean);
  const webpFile = file.replace(/\.(jpe?g|png)$/i, ".webp");
  const hasWebp = fs.existsSync(path.join(galleryDir, webpFile));
  return {
    url: `${import.meta.env.BASE_URL}images/astrophotography/${file}`,
    // Pre-generated WebP sibling (see scripts, or regenerate with sharp)
    // — same content, ~40% smaller. Falls back to the JPG/PNG when a
    // browser doesn't support it or no .webp was generated for a file.
    webpUrl: hasWebp ? `${import.meta.env.BASE_URL}images/astrophotography/${webpFile}` : undefined,
    label,
    filename: file,
    date: meta.date ?? "",
    dateLabel,
    detail: captionParts.length > 0 ? captionParts.join(" · ") : undefined,
  };
})
  // Newest first, by capture date (see astro-gallery-meta.ts). Undated
  // photos fall to the end; ties break alphabetically for a stable order.
  .sort((a, b) => b.date.localeCompare(a.date) || a.filename.localeCompare(b.filename));

const BASE = import.meta.env.BASE_URL;

// Rolling hero at the top of the page: filenames from the gallery, in
// display order. Each slide links to the same lightbox as the gallery.
const HERO_FILES = ["viel.jpg", "rosette.jpg", "californianebula.jpg", "heasrt.jpg", "m16.jpg", "flyspiderflame.jpg"];
const heroSlides = HERO_FILES.map((f) => ({ item: galleryItems.find((g) => g.filename === f), index: galleryItems.findIndex((g) => g.filename === f) }))
  .filter((s) => s.item);

const sections = [
  { id: "gear", no: "01", title: "The Gear", note: "Optics, mount, and the kit that runs all night" },
  { id: "remote", no: "02", title: "Remote Control", note: "How the rig runs unattended" },
  { id: "planning", no: "03", title: "Target Planning", note: "Choosing what to shoot, and when" },
  { id: "sequence", no: "04", title: "Imaging Sequence", note: "Polar alignment to calibration frames" },
  { id: "tilt", no: "05", title: "Sensor Tilt", note: "Why fast optics need tilt correction" },
  { id: "processing", no: "06", title: "Processing", note: "From raw subs to a finished image" },
];

const optics = [
  {
    name: "William Optics RedCat 51",
    role: "Refractor",
    note: "Compact f/4.9 petzval apo, small and light enough to travel with, used for wide-field targets that don't need the reach of a full telescope.",
    url: "https://williamoptics.com/products/redcat-51-ii",
  },
  {
    name: "Apertura CarbonStar 200",
    role: "Newtonian",
    note: "8\" f/4 imaging Newtonian, carbon-fiber tube: the OTA behind the second rendition in the Newtonian telescope project.",
    url: "https://www.highpointscientific.com/apertura-carbonstar-200-imaging-newtonian",
  },
  {
    name: "Celestron EdgeHD 8",
    role: "SCT",
    note: "8\" aplanatic Schmidt-Cassegrain, a flat, coma-free field at longer focal length for targets that need more reach than the Newtonian or the 135mm.",
    url: "https://agenaastro.com/celestron-edgehd-800-cge-ota-91030-xlt.html",
  },
  {
    name: "Samyang/Rokinon 135mm f/2",
    role: "Telephoto lens",
    note: "Fast, all-manual telephoto lens for wide-field targets. See the Rokinon rig project for the custom mounting and focusing hardware built around it.",
    url: "https://rokinon.com/products/135mm-f2-0-full-frame-telephoto",
  },
];

const gear = [
  {
    name: "ZWO AM3",
    role: "Mount",
    note: "Strain-wave harmonic-drive equatorial mount, carrying the imaging train with essentially none of the backlash or periodic error of a traditional worm-gear mount.",
    url: "https://agenaastro.com/shop-by-brand/zwo-am3-strain-wave-drive-equatorial-mount-head.html",
  },
  {
    name: "ZWO TC40",
    role: "Tripod",
    note: "Carbon-fiber tripod built for the AM3's harmonic-drive mount family, rigid enough to keep vibration out of long guided exposures.",
    url: "https://agenaastro.com/zwo-tc40-carbon-fiber-tripod.html",
  },
  {
    name: "ZWO PE200",
    role: "Pier extension",
    note: "200mm of extra height between tripod and mount head, clearing tripod-leg interference at higher declinations.",
    url: "https://agenaastro.com/zwo-200mm-7-9-pier-extension-for-am3-am5-mount-pe200.html",
  },
  {
    name: "MeLE Quieter 4C",
    role: "Control PC",
    note: "Fanless mini PC that runs the full capture stack (NINA, guiding, drivers) on the mount without adding its own fan noise or vibration.",
    url: "https://www.amazon.com/MeLE-Mini-Quieter-4C-Astrophotography/dp/B0CP3YL6J7",
  },
  {
    name: "SVBONY SV241",
    role: "Power distribution",
    note: "Splits a single 12V feed out to the mount, camera, dew heaters, and focuser. This is the base SV241: manual switching, no ASCOM/computer control.",
    url: "https://www.svbony.com/products/sv241-astronomical-powerbox",
  },
  {
    name: "WandererCover V4-EC, 225mm",
    role: "Motorized flat panel",
    note: "Motorized flip-flat cover with a built-in flat panel for the wide-field train, closing automatically, then evening out vignetting and dust motes across the larger aperture.",
    url: "https://www.wandererastro.com/sys-pd/14.html",
  },
  {
    name: "WandererCover V4-EC, 100mm",
    role: "Motorized flat panel",
    note: "Same motorized flip-flat design, sized for the narrower guide/OAG optical path.",
    url: "https://agenaastro.com/wandererastro-wanderer-cover-v4-ec-100mm.html",
  },
  {
    name: "ZWO OAG",
    role: "Off-axis guider",
    note: "Picks guide-star light from just outside the imaging sensor's field through a small prism, so guiding sees the same optical path, and the same flexure, as the imaging camera.",
    url: "https://agenaastro.com/zwo-oag-off-axis-guider.html",
  },
  {
    name: "ZWO ASI174MM Mini",
    role: "Guide camera",
    note: "Small, sensitive mono guide camera feeding the OAG.",
    url: "https://agenaastro.com/zwo-asi174mm-mini-cmos-monochrome-astronomy-imaging-camera.html",
  },
  {
    name: "PrimaLuceLab ESATTO 2\"",
    role: "Robotic focuser",
    note: "Motorized Crayford focuser with 15mm of travel and 0.04-micron step resolution, controlled over USB-C or Wi-Fi for repeatable, temperature-compensated focus moves without touching the scope.",
    url: "https://optcorp.com/products/primalucelab-esatto-2",
  },
  {
    name: "ZWO EAF",
    role: "Autofocuser",
    note: "Electronic focus motor in service since 2024, driving a 7.5-degree stepper through a 1:128 internal gearbox; see the Rokinon rig project for the belt-drive focuser built around this same motor.",
    url: "https://www.zwoastro.com/product/eaf/",
  },
];
---

<Layout
  title="Astrophotography | Henry Nickless"
  description="How Henry Nickless shoots deep-sky astrophotography: gear, mounts, focusers, and the processing workflow behind the shots."
  image="veil-nebula.jpg"
  variant="gallery"
>
  <section class="astro-hero" aria-roledescription="carousel" aria-label="Featured astrophotography">
    <div class="astro-hero-track">
      {heroSlides.map((s, i) => (
        <button type="button" class:list={["astro-hero-slide", { "is-active": i === 0 }]} data-slide={i} data-index={s.index} aria-label={`View ${s.item!.label} larger`} tabindex={i === 0 ? 0 : -1}>
          <picture>
            {s.item!.webpUrl && <source srcset={s.item!.webpUrl} type="image/webp" />}
            <img src={s.item!.url} alt={s.item!.label} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} />
          </picture>
        </button>
      ))}
    </div>
    <div class="astro-hero-overlay">
      <span class="eyebrow">// Astrophotography</span>
      <h1>Deep-Sky Imaging</h1>
      <p class="astro-hero-caption mono">
        {heroSlides.map((s, i) => (
          <span class:list={["astro-hero-caption-item", { "is-active": i === 0 }]} data-caption={i}>
            {s.item!.label}{s.item!.dateLabel && <span class="astro-hero-caption-date"> · {s.item!.dateLabel}</span>}
          </span>
        ))}
      </p>
    </div>
    <div class="astro-hero-controls">
      <button type="button" class="astro-hero-arrow" id="astro-hero-prev" aria-label="Previous image">‹</button>
      <div class="astro-hero-dots" role="tablist">
        {heroSlides.map((s, i) => (
          <button type="button" class:list={["astro-hero-dot", { "is-active": i === 0 }]} data-dot={i} aria-label={`Show ${s.item!.label}`}></button>
        ))}
      </div>
      <button type="button" class="astro-hero-arrow" id="astro-hero-next" aria-label="Next image">›</button>
    </div>
  </section>

  <nav class="astro-jump" aria-label="On this page">
    <p class="astro-jump-lede">
      Everything here was captured on my own rig and processed in
      PixInsight and Photoshop. The gallery is right below; the write-ups
      on how these photos get made are linked here.
    </p>
    <div class="astro-jump-grid">
      {sections.map((sec) => (
        <a href={`#${sec.id}`} class="astro-jump-link">
          <span class="astro-jump-no mono">{sec.no}</span>
          <span class="astro-jump-title">{sec.title}</span>
          <span class="astro-jump-note">{sec.note}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="cut-line" id="gallery"><span>Gallery</span></div>

  {galleryItems.length > 0 ? (
    <>
      <p class="mono" style="color: var(--paper-dim); font-size: 0.8rem; margin: -0.5rem 0 1.5rem;">
        {galleryItems.length} photos, newest first. Click one to view it larger or download it.
      </p>
      <div class="astro-gallery">
        {galleryItems.map((item, i) => (
          <button type="button" class="astro-gallery-item" data-index={i} aria-label={`View ${item.label}, photo ${i + 1} of ${galleryItems.length}`}>
            <picture>
              {item.webpUrl && <source srcset={item.webpUrl} type="image/webp" />}
              <img src={item.url} alt={item.label} title={item.label} loading="lazy" />
            </picture>
            <span class="gallery-caption"><span class="gallery-caption-title">{item.label}</span>{item.dateLabel && <span class="gallery-caption-date">{item.dateLabel}</span>}</span>
          </button>
        ))}
      </div>

      <script type="application/json" id="astro-gallery-data" set:html={JSON.stringify(galleryItems)} />

      <div id="astro-lightbox" class="astro-lightbox" hidden>
        <button type="button" class="astro-lightbox-close" id="astro-lightbox-close" aria-label="Close">✕</button>
        <button type="button" class="astro-lightbox-nav astro-lightbox-prev" id="astro-lightbox-prev" aria-label="Previous photo">‹</button>
        <div class="astro-lightbox-stage">
          <img id="astro-lightbox-img" src="" alt="" />
          <div class="astro-lightbox-bar">
            <span>
              <span id="astro-lightbox-count" class="mono"></span>
              <span id="astro-lightbox-detail" class="mono astro-lightbox-detail"></span>
            </span>
            <a id="astro-lightbox-download" class="mono astro-lightbox-download" download>Download ↓</a>
          </div>
        </div>
        <button type="button" class="astro-lightbox-nav astro-lightbox-next" id="astro-lightbox-next" aria-label="Next photo">›</button>
      </div>
    </>
  ) : (
    <p class="editable-note">
      No photos in the gallery yet. Drop JPGs into
      public/images/astrophotography/ and rebuild.
    </p>
  )}

  <div class="cut-line" id="methods"><span>How I Take These Photos</span></div>

  <p>
      Every image on this page runs through the same pipeline: a rig that
      sets up and operates itself for the night, a fixed sequence that
      handles focus, pointing, and calibration without help, and a
      processing pass that turns a stack of noisy sub-exposures into a
      finished photo. The sections below walk through the gear, the
      unattended imaging sequence, the tilt-correction problem that fast
      optics create, and how a stack of raw frames becomes a final image.
  </p>

  <div class="cut-line" id="gear"><span>The Gear</span></div>

  <h3>Optics</h3>
  <p>
    Four scopes and lenses in rotation, each suited to a different kind
    of target. Two of them have their own full project writeups: the <a href={`${BASE}projects/rokinon-135mm-astro-rig`}>Rokinon 135mm f/2 rig</a> for the
    custom ring system and focuser built around it, and the <a href={`${BASE}projects/newtonian-telescope`}>Newtonian telescope</a> project for
    the custom components built around the CarbonStar 200 below.
  </p>

  <div class="gear-grid">
    {optics.map((g) => (
      <div class="gear-card">
        <span class="gear-role mono">{g.role}</span>
        <h3 class="gear-name">{g.name}</h3>
        <p class="gear-note">{g.note}</p>
        <a href={g.url} target="_blank" rel="noopener noreferrer" class="mono gear-link">View product ↗</a>
      </div>
    ))}
  </div>

  <h3>Supporting gear</h3>
  <p>
    Everything below is the rest of the kit that keeps whichever optic
    is mounted up running through a full night unattended.
  </p>

  <div class="gear-grid">
    {gear.map((g) => (
      <div class="gear-card">
        <span class="gear-role mono">{g.role}</span>
        <h3 class="gear-name">{g.name}</h3>
        <p class="gear-note">{g.note}</p>
        <a href={g.url} target="_blank" rel="noopener noreferrer" class="mono gear-link">View product ↗</a>
      </div>
    ))}
    <div class="gear-card">
      <span class="gear-role mono">Dew control</span>
      <h3 class="gear-name">Dew shields</h3>
      <p class="gear-note">
        Custom-made passive dew shields on both the main imaging optics
        and the guide/OAG train, extending the effective tube length to
        keep the front elements from radiating heat away to a clear
        night sky.
      </p>
    </div>
  </div>


  <div class="cut-line" id="remote"><span>Data Acquisition &amp; Remote Control</span></div>

  <p>
    The rig lives outside for the night. It gets wheeled out and set up
    on the pier before dark, then stays out (polar aligned, cabled up,
    and running) until first light, rather than being shuttled back
    in between targets. Once it's set up, control passes entirely to a
    remote desktop session run from inside the house against the mini PC
    riding on the mount: focusing, plate solving, sequencing, and
    shutting down at the end of the night all happen over that link. The
    only reason to go back outside is to physically move the gear, at
    setup and again at pack-up the next morning.
  </p>

  <div class="cut-line" id="planning"><span>Target Planning</span></div>

  <p>
    Targets get chosen before the mount ever goes outside. Stellarium
    handles the logistics: what's up, when it transits, and how it
    clears the local horizon and any obstructions on a given night.
    AstroBin is the discovery tool: browsing what other imagers have
    captured with similar gear and field of view turns up targets worth
    adding to the list that a star atlas alone wouldn't necessarily
    suggest.
  </p>

  <div class="cut-line" id="sequence"><span>Imaging Sequence</span></div>

  <p>
    A full run follows the same sequence every time, almost entirely
    unattended:
  </p>

  <ol class="seq-list">
    <li><strong>Polar alignment</strong>: dialing in the mount's polar axis first, since tracking, guiding, and plate solving all inherit this error.</li>
    <li><strong>Autofocus</strong>: the imaging train autofocuses on a nearby star before the sequence starts, and again through the night as temperature drifts.</li>
    <li><strong>Guide camera focus</strong>: set manually once per setup; the guide train just needs to lock onto guide stars, not hold focus as tightly as the imaging camera.</li>
    <li><strong>Target selection, slew &amp; plate solve</strong>: the mount slews to the chosen target and a plate solve confirms (and corrects) the actual pointing against the planned coordinates before any exposures start.</li>
    <li><strong>Exposure</strong>: the sequence exposes through a given filter for the planned sub length and count.</li>
    <li><strong>Calibration frames</strong>: bias/dark frames come from a reusable library, re-shot roughly once a year as the sensor's noise characteristics drift; flats are captured fresh every session, automatically, through NINA driving the flat panel, so vignetting and dust-mote correction always matches that night's exact optical setup.</li>
  </ol>

  <div class="cut-line" id="tilt"><span>Sensor Tilt</span></div>

  <p>
    Every optical system has one flat plane where the image actually
    comes to focus. If the sensor isn't perfectly perpendicular to the
    incoming light cone, even by a fraction of a degree, one side of
    the frame sits slightly closer to that plane than the other, and
    stars stretch into small ellipses toward whichever corner is
    furthest from true focus. On a fast, wide-aperture system the depth
    of focus is shallow enough that a tilt error worth caring about is
    measured in thousandths of a millimeter at the sensor's edge, not
    something that's reliably adjustable by hand, especially not
    repeatably across setups. An automated tilt adjuster (fine
    adjustment screws driven under motor control instead of by hand)
    corrects that error in small, repeatable steps and lets the result
    get verified against real star data instead of guesswork, and
    re-checked whenever the imaging train gets reconfigured.
  </p>

  <div class="tilt-figure-row">
    <figure class="tilt-figure">
      <svg viewBox="0 0 460 165" role="img" aria-label="Diagram comparing star shapes across the sensor with tilt present versus corrected">
        <g transform="translate(10,15)">
          <rect x="0" y="0" width="180" height="110" fill="none" stroke="var(--line-500)" stroke-width="1.5" />
          <circle cx="14" cy="14" r="2.6" fill="var(--redline)" />
          <circle cx="166" cy="14" r="4.5" fill="none" stroke="var(--redline)" stroke-width="1.2" />
          <ellipse cx="90" cy="55" rx="4" ry="3" fill="none" stroke="var(--redline)" stroke-width="1" transform="rotate(35 90 55)" />
          <ellipse cx="14" cy="96" rx="5.5" ry="3.5" fill="none" stroke="var(--redline)" stroke-width="1.2" transform="rotate(35 14 96)" />
          <ellipse cx="166" cy="96" rx="10" ry="4.5" fill="none" stroke="var(--redline)" stroke-width="1.5" transform="rotate(35 166 96)" />
          <text x="90" y="130" class="tilt-cap" text-anchor="middle">TILTED</text>
        </g>
        <g transform="translate(265,15)">
          <rect x="0" y="0" width="180" height="110" fill="none" stroke="var(--line-500)" stroke-width="1.5" />
          <circle cx="14" cy="14" r="2.6" fill="var(--redline)" />
          <circle cx="166" cy="14" r="2.6" fill="var(--redline)" />
          <circle cx="90" cy="55" r="2.6" fill="var(--redline)" />
          <circle cx="14" cy="96" r="2.6" fill="var(--redline)" />
          <circle cx="166" cy="96" r="2.6" fill="var(--redline)" />
          <text x="90" y="130" class="tilt-cap" text-anchor="middle">CORRECTED</text>
        </g>
      </svg>
      <figcaption class="mono tilt-caption"><span class="tilt-fignum">FIG. 01</span>STAR SHAPE ACROSS THE FRAME: TILTED VS. CORRECTED</figcaption>
    </figure>

    <figure class="tilt-figure">
      <svg viewBox="0 0 360 230" role="img" aria-label="Side-view schematic of a tilted sensor relative to the ideal focal plane">
        <!-- optical axis -->
        <line x1="15" y1="115" x2="340" y2="115" stroke="var(--line-500)" stroke-width="1" stroke-dasharray="4 4" />
        <text x="20" y="107" class="tilt-cap">OPTICAL AXIS</text>

        <!-- ideal focal plane, perpendicular to the axis -->
        <line x1="235" y1="40" x2="235" y2="190" stroke="var(--line-500)" stroke-width="1" stroke-dasharray="3 3" />
        <line x1="145" y1="26" x2="233" y2="41" stroke="var(--line-500)" stroke-width="0.75" stroke-dasharray="2 2" />
        <text x="55" y="29" class="tilt-cap">IDEAL FOCAL PLANE</text>

        <!-- tilted sensor, crossing the ideal plane on-axis -->
        <line x1="210" y1="40" x2="260" y2="190" stroke="var(--redline)" stroke-width="1.8" />
        <line x1="222" y1="65" x2="278" y2="52" stroke="var(--redline)" stroke-width="0.75" stroke-dasharray="2 2" />
        <text x="281" y="55" class="tilt-cap" fill="var(--redline)">TILTED SENSOR</text>

        <!-- crossing point: sharp focus -->
        <circle cx="235" cy="115" r="3.2" fill="var(--redline)" />
        <line x1="238" y1="118" x2="252" y2="140" stroke="var(--redline)" stroke-width="0.75" stroke-dasharray="2 2" />
        <text x="238" y="152" class="tilt-cap" fill="var(--redline)">SHARP FOCUS</text>

        <!-- far end of sensor: defocused -->
        <circle cx="260" cy="190" r="8" fill="none" stroke="var(--redline)" stroke-width="1.3" />
        <line x1="255" y1="199" x2="235" y2="212" stroke="var(--redline)" stroke-width="0.75" stroke-dasharray="2 2" />
        <text x="150" y="217" class="tilt-cap" fill="var(--redline)">DEFOCUSED, SAME EXPOSURE</text>
      </svg>
      <figcaption class="mono tilt-caption"><span class="tilt-fignum">FIG. 02</span>SENSOR TILT, SIDE VIEW (EXAGGERATED FOR CLARITY)</figcaption>
    </figure>
  </div>

  <div class="cut-line" id="processing"><span>Processing</span></div>

  <p>
    A finished image starts as anywhere from dozens to a few hundred
    individual sub-exposures, each one mostly noise with a faint, real
    signal buried in it. PixInsight combines them through pixel-by-pixel
    integration (matrix math across the whole stack), averaging with
    rejection algorithms that throw out satellite trails, cosmic-ray
    hits, and other single-frame artifacts rather than simply layering
    everything together. Signal-to-noise builds with the square root of
    the sub count, so doubling the number of subs only buys about a 40%
    improvement in signal-to-noise: the real tradeoff behind every
    session, since more subs always help but with steadily diminishing
    returns against the hours it costs to get them. Before the stack is
    combined, every frame gets normalized, scaled and offset so that
    frame-to-frame differences in sky brightness, transparency, or moon
    position don't bias the result.
  </p>

  <p>
    Everything up to that point is math. What comes after is where the
    process gets genuinely subjective; this is the part that's art, not
    measurement. Images here are captured in real, natural color, not
    narrowband-mapped or artificially recolored, and stretched through a
    histogram transform to bring out detail that's present in the linear
    data but invisible on a straight display. That step remaps what's
    already in the frame onto a range a screen can actually show; it
    doesn't invent anything that isn't there. From there, a set of
    AI-assisted tools handles gradient removal (correcting for skyglow
    and light pollution that vary across the frame), deconvolution, and
    noise reduction, cleaning up what the optics and the sky introduced
    without changing what the target actually looks like. Plate solving
    plus SPCC (Spectrophotometric Color Calibration) pins the color
    balance to real stellar spectra in the field instead of an eyeballed
    white balance, so the final color is a calibrated fit to actual data.
  </p>

  <p>
    The last pass happens in Photoshop, pulling out finer local detail
    and nudging color ever so slightly, not to invent anything, but to
    draw the eye toward the parts of the image that matter.
  </p>

</Layout>

