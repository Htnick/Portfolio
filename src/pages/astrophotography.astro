    margin: 2rem 0 0;
  }
  .pipe-stage-title {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--redline);
    font-weight: 500;
  }
  .pipe-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  .pipe-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-500);
    background: var(--ink-800);
  }
  .pipe-thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #2a2a2a;
    cursor: zoom-in;
  }
  .pipe-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s ease;
  }
  .pipe-thumb:hover img {
    transform: scale(1.04);
  }
  .pipe-body {
    padding: 0.7rem 0.8rem 0.85rem;
  }
  .pipe-no {
    font-size: 0.68rem;
    color: var(--redline);
    letter-spacing: 0.08em;
  }
  .pipe-body h5 {
    margin: 0.15rem 0 0.3rem;
    font-size: 0.95rem;
    color: var(--paper);
  }
  .pipe-body p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--paper-dim);
  }

  /* ---------- Jump links ---------- */
  .astro-jump {
    margin: 2.25rem 0 0;
  }
  .astro-jump-lede {
    max-width: 62ch;
    color: var(--paper-dim);
    margin-bottom: 1.1rem;
  }
  .astro-jump-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.6rem;
  }
  .astro-jump-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-500);
    background: var(--ink-800);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .astro-jump-link:hover {
    border-color: var(--redline);
    transform: translateY(-2px);
  }
  .astro-jump-no {
    font-size: 0.68rem;
    color: var(--redline);
    letter-spacing: 0.08em;
  }
  .astro-jump-title {
    color: var(--paper);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .astro-jump-note {
    color: var(--paper-dim);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  /* ---------- Gallery ----------
     Uniform grid: every thumbnail is the same 3:2 tile, center-cropped
     with object-fit. The lightbox always shows the full, uncropped frame. */
  .astro-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
    margin: 0 0 1rem;
  }
  .astro-gallery-item {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 1px solid var(--line-500);
    background: var(--ink-800);
    overflow: hidden;
    cursor: zoom-in;
    text-align: left;
  }
  .astro-gallery-item picture {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #000;
  }
  .astro-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .astro-gallery-item:hover img {
    transform: scale(1.05);
  }
  .astro-gallery-item .gallery-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--paper-dim);
    padding: 0.55rem 0.6rem;
    background: var(--ink-800);
  }
  .gallery-caption-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--paper);
  }
  .gallery-caption-date {
    flex-shrink: 0;
    color: var(--paper-dim);
  }

  .astro-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(10, 8, 6, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 2rem;
  }
  .astro-lightbox[hidden] {
    display: none;
  }
  .astro-lightbox-stage {
    max-width: min(90vw, 1200px);
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .astro-lightbox-stage img {
    max-width: 100%;
    max-height: 74vh;
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .astro-lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 0.75rem;
    color: #cfc7ba;
    font-size: 0.78rem;
  }
  .astro-lightbox-bar span {
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .astro-lightbox-detail {
    display: block;
    margin-top: 0.2rem;
    color: #a39c90;
    font-size: 0.7rem;
  }
  .astro-lightbox-detail:empty {
    display: none;
  }
  .astro-lightbox-download {
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 0.4rem 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .astro-lightbox-download:hover {
    border-color: var(--redline);
    color: var(--redline);
  }

  .astro-lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 1.6rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.5rem;
  }
  .astro-lightbox-nav {
    background: none;
    border: none;
    color: #fff;
    font-size: 2.5rem;
    cursor: pointer;
    padding: 0.5rem 1rem;
    line-height: 1;
  }
  .astro-lightbox-nav:hover,
  .astro-lightbox-close:hover {
    color: var(--redline);
  }

  @media (max-width: 640px) {
    .astro-lightbox-nav {
      font-size: 2rem;
      padding: 0.5rem;
    }
    .astro-lightbox {
      padding: 1rem;
    }
  }
</style>

<script>
  const dataEl = document.getElementById("astro-gallery-data");
  const items: { url: string; webpUrl?: string; label: string; detail?: string }[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

  const lightbox = document.getElementById("astro-lightbox") as HTMLDivElement | null;
  const lightboxImg = document.getElementById("astro-lightbox-img") as HTMLImageElement | null;
  const countEl = document.getElementById("astro-lightbox-count");
  const detailEl = document.getElementById("astro-lightbox-detail");
  const downloadEl = document.getElementById("astro-lightbox-download") as HTMLAnchorElement | null;
  let current = 0;

  function render() {
    if (!lightboxImg || !countEl || !downloadEl || items.length === 0) return;
    const item = items[current];
    // Display the lighter WebP when available; downloads always offer
    // the original JPG/PNG for compatibility and full quality.
    lightboxImg.src = item.webpUrl ?? item.url;
    lightboxImg.alt = item.label;
    countEl.textContent = `${item.label} (${current + 1} / ${items.length})`;
    if (detailEl) detailEl.textContent = item.detail ?? "";
    downloadEl.href = item.url;
    downloadEl.setAttribute("download", item.url.split("/").pop() || "photo.jpg");
  }

  function open(index: number) {
    current = index;
    render();
    if (lightbox) {
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
    }
  }

  function close() {
    if (lightbox) {
      lightbox.hidden = true;
      document.body.style.overflow = "";
    }
  }

  function prev() {
    current = (current - 1 + items.length) % items.length;
    render();
  }

  function next() {
    current = (current + 1) % items.length;
    render();
  }

  document.querySelectorAll<HTMLButtonElement>(".astro-gallery-item").forEach((btn) => {
    btn.addEventListener("click", () => open(Number(btn.dataset.index)));
  });
  document.getElementById("astro-lightbox-close")?.addEventListener("click", close);
  document.getElementById("astro-lightbox-prev")?.addEventListener("click", prev);
  document.getElementById("astro-lightbox-next")?.addEventListener("click", next);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener("keydown", (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") prev();
    if (e.key === "ArrowRight") next();
  });

  // ---------- Rolling hero ----------
  const heroSlides = Array.from(document.querySelectorAll<HTMLButtonElement>(".astro-hero-slide"));
  const heroCaptions = Array.from(document.querySelectorAll<HTMLElement>(".astro-hero-caption-item"));
  const heroDots = Array.from(document.querySelectorAll<HTMLButtonElement>(".astro-hero-dot"));
  const heroEl = document.querySelector<HTMLElement>(".astro-hero");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const HERO_INTERVAL_MS = 6500;
  let heroCurrent = 0;
  let heroTimer: number | undefined;
  let heroPaused = false;

  function showSlide(i: number) {
    if (heroSlides.length === 0) return;
    heroCurrent = (i + heroSlides.length) % heroSlides.length;
    heroSlides.forEach((el, n) => {
      const on = n === heroCurrent;
      el.classList.toggle("is-active", on);
      el.tabIndex = on ? 0 : -1;
    });
    heroCaptions.forEach((el, n) => el.classList.toggle("is-active", n === heroCurrent));
    heroDots.forEach((el, n) => {
      el.classList.toggle("is-active", n === heroCurrent);
      el.setAttribute("aria-selected", String(n === heroCurrent));
    });
  }

  function startHero() {
    stopHero();
    if (reduceMotion || heroPaused || heroSlides.length < 2) return;
    heroTimer = window.setInterval(() => showSlide(heroCurrent + 1), HERO_INTERVAL_MS);
  }
  function stopHero() {
    if (heroTimer !== undefined) window.clearInterval(heroTimer);
    heroTimer = undefined;
  }

  heroSlides.forEach((el) => el.addEventListener("click", () => open(Number(el.dataset.index))));
  heroDots.forEach((el, n) => el.addEventListener("click", () => { showSlide(n); startHero(); }));
  document.getElementById("astro-hero-prev")?.addEventListener("click", () => { showSlide(heroCurrent - 1); startHero(); });
  document.getElementById("astro-hero-next")?.addEventListener("click", () => { showSlide(heroCurrent + 1); startHero(); });
  heroEl?.addEventListener("mouseenter", () => { heroPaused = true; stopHero(); });
  heroEl?.addEventListener("mouseleave", () => { heroPaused = false; startHero(); });
  heroEl?.addEventListener("focusin", () => { heroPaused = true; stopHero(); });
  heroEl?.addEventListener("focusout", () => { heroPaused = false; startHero(); });
  document.addEventListener("visibilitychange", () => (document.hidden ? stopHero() : startHero()));
  startHero();
</script>
